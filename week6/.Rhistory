# This creates a subset with just 2007 data
# We'll learn how filter() works properly in Week 3
gap_2007 <- filter(gapminder, year == 2007)
# Check it worked
nrow(gap_2007)  # Should be 142 countries
Should be 142 countries
# Should be 142 countries
ggplot(gap_2007, aes(x = lifeExp)) +
geom_histogram(bins = 25, fill = "steelblue", colour = "white") +
labs(title = "Distribution of life expectancy in 2007",
x = "Life expectancy (years)",
y = "Number of countries") +
theme_minimal()
summary(gap_2007)
summary(gap_2007$lifeExp)
p1 <- ggplot(gap_2007, aes(x = lifeExp)) +
geom_histogram(bins = 25, fill = "steelblue", colour = "white") +
labs(title = "Histogram", x = "Life expectancy (years)", y = "Count") +
theme_minimal()
p2 <- ggplot(gap_2007, aes(x = lifeExp)) +
geom_density(fill = "steelblue", alpha = 0.5) +
labs(title = "Density plot", x = "Life expectancy (years)", y = "Density") +
theme_minimal()
p3 <- ggplot(gap_2007, aes(x = "", y = lifeExp)) +
geom_boxplot(fill = "steelblue", alpha = 0.5) +
labs(title = "Box plot", x = NULL, y = "Life expectancy (years)") +
theme_minimal()
p1 / p2 / p3
ggplot(gap_2007, aes(x = gdpPercap)) +
geom_histogram(bins = 30, fill = "darkgreen", colour = "white") +
labs(title = "Distribution of GDP per capita in 2007",
x = "GDP per capita ($)",
y = "Number of countries") +
theme_minimal()
ggplot(gap_2007, aes(x = continent, y = lifeExp, fill = continent)) +
geom_violin(alpha = 0.5) +
geom_boxplot(width = 0.2, alpha = 0.8) +
labs(title = "Life expectancy by continent: violin + box",
x = "Continent",
y = "Life expectancy (years)") +
theme_minimal() +
theme(legend.position = "none")
ggplot(gap_2007, aes(x = continent, y = lifeExp, fill = continent)) +
geom_boxplot(alpha = 0.7, outlier.shape = NA) +  # Hide outlier dots from box (we're showing all points)
geom_jitter(width = 0.2, alpha = 0.5, size = 2) +
labs(title = "Life expectancy by continent: box plot + points",
x = "Continent",
y = "Life expectancy (years)") +
theme_minimal() +
theme(legend.position = "none")
